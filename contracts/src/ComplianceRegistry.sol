pragma solidity ^0.8.30;

import {Ownable, Ownable2Step} from "@openzeppelin/contracts/access/Ownable2Step.sol";
import {IComplianceVerifier} from "./interfaces/IComplianceVerifier.sol";
import {RootRegistry} from "./RootRegistry.sol";

/// @notice Records that a trading address passed the compliance proof for a trade. Everything
/// the chain learns about the party is the trade id, the address, a timestamp and the version of
/// the sanctions list it was checked against, plus a ciphertext only the regulator can open.
contract ComplianceRegistry is Ownable2Step {
    uint256 private constant NULLIFIER = 0;
    uint256 private constant C1X = 1;
    uint256 private constant C1Y = 2;
    uint256 private constant C2 = 3;
    uint256 private constant TRADE_ID = 4;
    uint256 private constant TRADING_ADDRESS = 5;
    uint256 private constant ISSUERS_ROOT = 6;
    uint256 private constant SANCTIONS_ROOT = 7;
    uint256 private constant REVOCATION_ROOT = 8;
    uint256 private constant MIN_TIER = 9;
    uint256 private constant VALID_AT = 10;
    uint256 private constant REGULATOR_X = 11;
    uint256 private constant REGULATOR_Y = 12;

    // Baby Jubjub: a * x^2 + y^2 = 1 + d * x^2 * y^2 over the BN254 scalar field.
    uint256 private constant CURVE_A = 168700;
    uint256 private constant CURVE_D = 168696;

    struct Attestation {
        uint64 attestedAt;
        uint64 sanctionsVersion;
    }

    struct Policy {
        uint8 minTier;
        uint64 maxProofAge;
        uint64 attestationTtl;
    }

    IComplianceVerifier public immutable verifier;
    RootRegistry public immutable issuers;
    RootRegistry public immutable sanctions;
    RootRegistry public immutable revocations;

    Policy public policy;
    uint256 public regulatorKeyX;
    uint256 public regulatorKeyY;

    mapping(uint256 nullifier => bool) public nullifierUsed;
    mapping(uint256 tradeId => mapping(address party => Attestation)) private _attestations;

    event Attested(
        uint256 indexed tradeId,
        address indexed party,
        uint256 nullifier,
        uint64 sanctionsVersion,
        uint256 c1x,
        uint256 c1y,
        uint256 c2
    );
    event PolicyUpdated(uint8 minTier, uint64 maxProofAge, uint64 attestationTtl);
    event RegulatorKeyUpdated(uint256 x, uint256 y);

    error NullifierUsed();
    error AddressOutOfRange();
    error RootNotAccepted();
    error TierTooLow();
    error ProofNotCurrent();
    error WrongRegulatorKey();
    error InvalidProof();
    error InvalidRegulatorKey();

    constructor(
        address initialOwner,
        IComplianceVerifier verifier_,
        RootRegistry issuers_,
        RootRegistry sanctions_,
        RootRegistry revocations_,
        Policy memory policy_
    ) Ownable(initialOwner) {
        verifier = verifier_;
        issuers = issuers_;
        sanctions = sanctions_;
        revocations = revocations_;
        policy = policy_;
        emit PolicyUpdated(policy_.minTier, policy_.maxProofAge, policy_.attestationTtl);
    }

    function setPolicy(Policy calldata newPolicy) external onlyOwner {
        policy = newPolicy;
        emit PolicyUpdated(newPolicy.minTier, newPolicy.maxProofAge, newPolicy.attestationTtl);
    }

    /// @dev The key must be a Baby Jubjub point generated by the regulator's tooling (prime-order subgroup).
    function setRegulatorKey(uint256 x, uint256 y) external onlyOwner {
        if (x == 0 || !_onCurve(x, y)) revert InvalidRegulatorKey();
        regulatorKeyX = x;
        regulatorKeyY = y;
        emit RegulatorKeyUpdated(x, y);
    }

    /// @notice Verifies a compliance proof and records the attestation for the proof's trading address.
    function attest(
        uint256[2] calldata a,
        uint256[2][2] calldata b,
        uint256[2] calldata c,
        uint256[13] calldata signals
    ) external {
        if (nullifierUsed[signals[NULLIFIER]]) revert NullifierUsed();
        if (signals[TRADING_ADDRESS] > type(uint160).max) revert AddressOutOfRange();

        Policy memory p = policy;
        if (signals[MIN_TIER] < p.minTier) revert TierTooLow();
        uint256 validAt = signals[VALID_AT];
        if (validAt > block.timestamp || block.timestamp - validAt > p.maxProofAge) {
            revert ProofNotCurrent();
        }
        if (signals[REGULATOR_X] != regulatorKeyX || signals[REGULATOR_Y] != regulatorKeyY) {
            revert WrongRegulatorKey();
        }
        uint64 sanctionsVersion = sanctions.acceptedVersion(signals[SANCTIONS_ROOT]);
        if (
            sanctionsVersion == 0 || issuers.acceptedVersion(signals[ISSUERS_ROOT]) == 0
                || revocations.acceptedVersion(signals[REVOCATION_ROOT]) == 0
        ) revert RootNotAccepted();
        if (!verifier.verifyProof(a, b, c, signals)) revert InvalidProof();

        nullifierUsed[signals[NULLIFIER]] = true;
        address party = address(uint160(signals[TRADING_ADDRESS]));
        _attestations[signals[TRADE_ID]][party] = Attestation(uint64(block.timestamp), sanctionsVersion);
        emit Attested(
            signals[TRADE_ID], party, signals[NULLIFIER], sanctionsVersion, signals[C1X], signals[C1Y], signals[C2]
        );
    }

    function attestationOf(uint256 tradeId, address party) external view returns (Attestation memory) {
        return _attestations[tradeId][party];
    }

    /// @return True if `party` holds an attestation for `tradeId` that has not expired.
    function isCompliant(uint256 tradeId, address party) external view returns (bool) {
        uint64 attestedAt = _attestations[tradeId][party].attestedAt;
        return attestedAt != 0 && block.timestamp <= uint256(attestedAt) + policy.attestationTtl;
    }

    function _onCurve(uint256 x, uint256 y) private pure returns (bool) {
        uint256 p = 21888242871839275222246405745257275088548364400416034343698204186575808495617;
        if (x >= p || y >= p) return false;
        uint256 x2 = mulmod(x, x, p);
        uint256 y2 = mulmod(y, y, p);
        uint256 left = addmod(mulmod(CURVE_A, x2, p), y2, p);
        uint256 right = addmod(1, mulmod(CURVE_D, mulmod(x2, y2, p), p), p);
        return left == right;
    }
}
