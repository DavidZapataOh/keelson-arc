<section class="section how" id="how" aria-labelledby="how-title">
  <div class="wrap">
    <h2 id="how-title">Three steps.<br />Both legs, or <span class="hl">neither.</span></h2>

    <div class="steps" id="steps">
      <div class="beam" id="beam" aria-hidden="true">
        <i class="beam-line"></i>
        <i class="beam-end"></i>
      </div>

      <article class="step" data-step="1">
        <header>
          <span class="num mono">01</span>
          <h3>Prepare</h3>
        </header>
        <p>
          Each side proves, from a credential, that it is valid and screened, without revealing who
          it is.
        </p>
        <svg class="fig" viewBox="0 0 360 220" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true">
          <g class="key">
            <circle cx="62" cy="64" r="24" fill="var(--bone)" />
            <circle cx="62" cy="64" r="6" />
            <path fill="var(--bone)" d="M57 88v82l5 8 5-8v-14l-9-4 9-4v-8l-6-3 6-3V88Z" />
          </g>
          <rect x="140" y="72" width="80" height="76" rx="6" fill="var(--bone)" />
          <path class="check" d="M162 112l13 14 24-30" stroke-width="2" pathLength="1" />
          <g class="key">
            <circle cx="298" cy="64" r="24" fill="var(--bone)" />
            <circle cx="298" cy="64" r="6" />
            <path fill="var(--bone)" d="M293 88v82l5 8 5-8v-14l-9-4 9-4v-8l-6-3 6-3V88Z" />
          </g>
        </svg>
      </article>

      <article class="step" data-step="2">
        <header>
          <span class="num mono">02</span>
          <h3>Commit</h3>
        </header>
        <p>Both sides lock the same terms. They stay private until settlement.</p>
        <svg class="fig" viewBox="0 0 360 220" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <rect x="30" y="38" width="120" height="144" rx="8" fill="var(--bone)" />
          <g class="bars" fill="currentColor" stroke="none">
            <rect x="48" y="62" width="84" height="12" />
            <rect x="48" y="86" width="56" height="12" />
            <rect x="48" y="110" width="76" height="12" />
            <rect x="48" y="134" width="44" height="12" />
          </g>
          <path d="M172 102h16M172 118h16" stroke-width="2" />
          <rect x="210" y="38" width="120" height="144" rx="8" fill="var(--bone)" />
          <g class="bars" fill="currentColor" stroke="none">
            <rect x="228" y="62" width="84" height="12" />
            <rect x="228" y="86" width="56" height="12" />
            <rect x="228" y="110" width="76" height="12" />
            <rect x="228" y="134" width="44" height="12" />
          </g>
        </svg>
      </article>

      <article class="step" data-step="3">
        <header>
          <span class="num mono">03</span>
          <h3>Settle</h3>
        </header>
        <p>
          If both proofs and both commitments match, both legs move in one transaction. Otherwise
          nothing moves.
        </p>
        <svg class="fig" viewBox="0 0 360 220" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <g class="leg leg-l">
            <rect x="74" y="30" width="66" height="160" rx="8" fill="var(--bone)" />
            <path d="M88 96h38M88 106h38M88 116h38" stroke-dasharray="5 4" />
          </g>
          <g class="leg leg-r">
            <rect x="196" y="30" width="66" height="160" rx="8" fill="var(--bone)" />
            <path d="M210 96h38M210 106h38M210 116h38" stroke-dasharray="5 4" />
          </g>
        </svg>
      </article>
    </div>
  </div>
</section>

