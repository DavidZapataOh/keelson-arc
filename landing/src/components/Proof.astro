---
const gates = [
  { n: "01", claim: "Credential valid and not revoked.", inputs: "issuersRoot, revocationRoot, minTier" },
  { n: "02", claim: "Not on the sanctions list in use.", inputs: "sanctionsRoot, validAt" },
  { n: "03", claim: "Bound to this trade and to the address that trades.", inputs: "tradeId, tradingAddress" },
];
---

<section class="section proof" id="proof" aria-labelledby="proof-title">
  <div class="wrap">
    <div class="head">
      <h2 id="proof-title">Proof, per trade.</h2>
      <p>Each side proves three things before anything moves, without saying who it is.</p>
    </div>

    <div class="track" id="track">
      <div class="beam" id="proof-beam" aria-hidden="true"><i></i></div>

      <div class="node start mono">
        <span class="dot"></span>
        <span>Trade<br />initiated</span>
      </div>

      {
        gates.map((g, i) => (
          <div class={`gate ${i === 2 ? "last" : ""}`} data-gate={i + 1}>
            <p class="claim">
              <span class="mono">{g.n}</span>
              {g.claim}
            </p>
            <div class="door" aria-hidden="true">
              <svg viewBox="0 0 196 292" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
                <path class="depth" d="M10 22 L162 66 Q170 68 170 77 V229 Q170 238 162 240 L10 284 Q2 286 2 278 V30 Q2 24 10 22Z" fill="var(--bone)" />
                <path class="face" d="M16 14 L168 58 Q176 60 176 69 V221 Q176 230 168 232 L16 276 Q8 278 8 270 V22 Q8 16 16 14Z" />
                <ellipse class="ap" cx="100" cy="146" rx="40" ry="54" fill="var(--bone)" />
                {i < 2 && <path class="lip" d="M64 124 C58 150 66 178 94 198" stroke-width="5" stroke-linecap="round" />}
                {i === 2 && <path class="tick" d="M80 148 L96 164 L122 128" stroke-width="3" stroke-linecap="round" pathLength="1" />}
              </svg>
            </div>
          </div>
        ))
      }

      <div class="node end mono">
        <span class="dot ok">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M6 12.5l4 4 8-9" /></svg>
        </span>
        <span>Proof<br />complete</span>
      </div>

      <div class="strip on-dark mono">
        {
          gates.map((g) => (
            <div>
              <span class="k">Public inputs</span>
              <span class="v">{g.inputs}</span>
            </div>
          ))
        }
      </div>
    </div>

    <p class="measured mono">
      25,378 constraints, 13 public signals. Proves in 879 ms, verifies in 8 ms. Measured with
      snarkjs on an Apple M4, 14 Oct 2026.
    </p>
  </div>
</section>

<style>
  .head {
    display: grid;
    gap: 24px;
  }

  h2 {
    font-size: clamp(2.6rem, 6vw, 5.6rem);
  }

  .head p {
    max-width: 44ch;
    font-size: 1.2rem;
    line-height: 1.5;
    color: var(--text-2);
  }

  .track {
    --beam: 10px;
    position: relative;
    margin-top: clamp(56px, 8vw, 104px);
    display: grid;
    grid-template-columns: 0.55fr repeat(3, minmax(0, 1fr)) 0.55fr;
    grid-template-rows: auto auto auto;
    column-gap: 0;
    align-items: start;
  }

  .beam {
    position: relative;
    z-index: 2;
    grid-row: 2;
    grid-column: 1 / -1;
    align-self: center;
    margin-inline: 24px;
    height: 24px;
    clip-path: inset(0 calc((1 - var(--p, 1)) * 100%) 0 0);
    pointer-events: none;
  }

  .beam i {
    position: absolute;
    inset: 50% 0 auto 0;
    height: var(--beam);
    transform: translateY(-50%);
    background: var(--vermilion);
  }

  .gate {
    display: contents;
  }

  .claim {
    grid-row: 1;
    padding: 0 20px 28px 0;
    max-width: 26ch;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .claim .mono {
    display: block;
    margin-bottom: 8px;
    font-size: 0.8rem;
    color: var(--vermilion-deep);
  }

  .gate[data-gate="1"] .claim,
  .gate[data-gate="1"] .door {
    grid-column: 2;
  }

  .gate[data-gate="2"] .claim,
  .gate[data-gate="2"] .door {
    grid-column: 3;
  }

  .gate[data-gate="3"] .claim,
  .gate[data-gate="3"] .door {
    grid-column: 4;
  }

  .door {
    grid-row: 2;
    position: relative;
    z-index: 1;
    justify-self: start;
    width: min(100% - 32px, 236px);
    margin-top: -6px;
    color: var(--graphite);
  }

  .door svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .ap,
  .lip {
    transition: stroke 240ms var(--ease-out);
  }

  .last .face {
    fill: var(--vermilion);
  }

  .tick {
    stroke-dasharray: 1;
    stroke-dashoffset: var(--tick, 0);
  }

  .node {
    grid-row: 2;
    align-self: stretch;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding-top: 48px;
    text-align: center;
    font-size: 0.8rem;
    line-height: 1.4;
  }

  .node.start {
    grid-column: 1;
  }

  .node.end {
    grid-column: 5;
  }

  .dot {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1.5px solid var(--graphite);
    border-radius: 50%;
    background: var(--bone);
    position: relative;
    z-index: 3;
  }

  .dot.ok {
    color: var(--vermilion-deep);
    border-color: var(--vermilion);
  }

  .dot svg {
    width: 22px;
    height: 22px;
  }

  .strip {
    grid-row: 3;
    grid-column: 2 / 5;
    margin-top: 28px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    background: var(--graphite);
    color: var(--bone);
    border-radius: var(--radius-m);
  }

  .strip div {
    display: grid;
    gap: 6px;
    padding: 18px 20px;
    font-size: 0.8rem;
    line-height: 1.45;
  }

  .strip div + div {
    border-left: 1px solid #2e3036;
  }

  .k {
    color: var(--warm-gray);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.7rem;
  }

  .measured {
    margin-top: 28px;
    max-width: 70ch;
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--text-2);
  }

  @media (max-width: 820px) {
    .track {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      padding-left: 40px;
      row-gap: 36px;
    }

    .gate {
      display: grid;
      grid-template-columns: 120px 1fr;
      gap: 20px;
      align-items: center;
    }

    .gate .claim,
    .gate .door {
      grid-column: auto !important;
      grid-row: 1;
    }

    .gate .door {
      grid-column: 1 !important;
      width: 120px;
      margin: 0;
    }

    .gate .claim {
      grid-column: 2 !important;
      padding: 0;
    }

    .node {
      grid-row: auto;
      grid-column: 1 !important;
      justify-items: start;
      grid-auto-flow: column;
      align-items: center;
      padding: 0;
      text-align: left;
    }

    .node.end {
      order: 5;
    }

    .dot {
      margin-top: 0;
    }

    .strip {
      order: 6;
      grid-row: auto;
      grid-column: 1;
      grid-template-columns: 1fr;
      margin-top: 0;
    }

    .strip div + div {
      border-left: 0;
      border-top: 1px solid #2e3036;
    }

    .beam {
      position: absolute;
      left: 8px;
      margin: 0;
      top: 20px;
      bottom: 220px;
      width: 24px;
      height: auto;
      clip-path: inset(0 0 calc((1 - var(--p, 1)) * 100%) 0);
    }

    .beam i {
      inset: 0 auto 0 50%;
      width: var(--beam);
      height: auto;
      transform: translateX(-50%);
    }
  }
</style>
