---
const terms = "25,000,000 USDC for 22,950,000 EURC";
const rows = [
  { label: "Terms, before settlement", market: null, counterparty: terms, regulator: null },
  { label: "Terms, after settlement", market: terms, counterparty: terms, regulator: terms },
  { label: "Who is behind each side", market: null, counterparty: null, regulator: "holder 7f3c…a9d2" },
  { label: "Both proofs verified", market: "yes", counterparty: "yes", regulator: "yes" },
  { label: "Lists and versions used", market: "list v12, 14 Oct 2026", counterparty: "list v12, 14 Oct 2026", regulator: "list v12, 14 Oct 2026" },
];
const views = [
  { key: "market", name: "Market", note: "Anyone watching Arc" },
  { key: "counterparty", name: "Counterparty", note: "The other side" },
  { key: "regulator", name: "Regulator", note: "Holding the key" },
] as const;
---

<section class="section views" id="views" aria-labelledby="views-title">
  <div class="wrap">
    <div class="head">
      <h2 id="views-title">Same trade.<br />Three different views.</h2>
      <p>
        Before it settles, the terms are a hash. After, they are public. Who is behind each side
        stays private, unless a regulator holds the key.
      </p>
    </div>

    <div class="windows">
      {
        views.map((v) => (
          <article class="win" data-view={v.key}>
            <header>
              <h3 class="mono">{v.name}</h3>
              <span class="mono who">{v.note}</span>
            </header>
            <dl>
              {rows.map((r) => {
                const value = r[v.key];
                return (
                  <div class="row">
                    <dt class="mono">{r.label}</dt>
                    <dd>
                      {value === null ? (
                        <>
                          <span class="bar closed" aria-hidden="true" />
                          <span class="sr">Hidden</span>
                        </>
                      ) : (
                        <>
                          <span class="val mono">{value}</span>
                          <span class="bar cover" aria-hidden="true" />
                        </>
                      )}
                    </dd>
                  </div>
                );
              })}
            </dl>
          </article>
        ))
      }
    </div>
    <p class="foot mono">Synthetic example. The proofs are public inputs; the credential never is.</p>
  </div>
</section>

<style>
  .head {
    display: grid;
    gap: 28px;
    max-width: 880px;
  }

  h2 {
    font-size: clamp(2.6rem, 6vw, 5.6rem);
  }

  .head p {
    max-width: 52ch;
    font-size: 1.2rem;
    line-height: 1.5;
    color: var(--text-2);
  }

  .windows {
    margin-top: clamp(48px, 6vw, 88px);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 28px);
  }

  .win {
    padding: 24px;
    border: 1.5px solid var(--graphite);
    border-radius: var(--radius-l);
    background: color-mix(in srgb, var(--bone) 86%, white);
  }

  header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 12px;
    padding-bottom: 14px;
    border-bottom: 2px solid var(--vermilion);
  }

  h3 {
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .who {
    font-size: 0.75rem;
    color: var(--text-2);
  }

  dl {
    margin: 0;
  }

  .row {
    display: grid;
    gap: 8px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }

  .row:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  dt {
    font-size: 0.75rem;
    color: var(--text-2);
  }

  dd {
    position: relative;
    margin: 0;
    min-height: 26px;
    display: flex;
    align-items: center;
  }

  .val {
    font-size: 0.9rem;
    line-height: 1.35;
  }

  .bar {
    display: block;
    background: var(--graphite);
    border-radius: 2px;
  }

  .closed {
    width: 100%;
    height: 22px;
  }

  .cover {
    position: absolute;
    inset: 0;
    transform: scaleX(0);
    transform-origin: right;
  }

  .foot {
    margin-top: 24px;
    font-size: 0.8rem;
    color: var(--text-2);
  }

  @media (max-width: 960px) {
    .windows {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
