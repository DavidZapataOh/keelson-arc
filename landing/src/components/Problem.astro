---
const messages = [
  { side: "a", text: "Agreed at 1.0765?", time: "14:02" },
  { side: "b", text: "Yes.", time: "14:03", note: "No confirmation" },
  { side: "a", text: "Can you send first?", time: "14:03" },
  { side: "b", text: "No, you send first.", time: "14:04" },
  { side: "a", text: "Sent. Waiting for you…", time: "14:05", note: "Sent first" },
  { side: "b", text: "", time: "14:47", note: "Still waiting", typing: true },
] as const;
---

<section class="section problem" id="problem" aria-labelledby="problem-title">
  <div class="wrap grid">
    <div class="lede">
      <h2 id="problem-title">The first side to move carries the risk.</h2>
      <p>
        Prefunding, side letters and chat confirmations leave one party exposed until the other
        delivers.
      </p>
    </div>

    <ol class="thread" aria-label="A synthetic OTC chat">
      {
        messages.map((m) => (
          <li class={`msg ${m.side}`} data-reveal>
            <div class="bubble-wrap">
              <div class="bubble">
                <span class="who mono" aria-hidden="true">{m.side.toUpperCase()}</span>
                {"typing" in m ? (
                  <span class="dots" aria-label="No reply">
                    <i /><i /><i />
                  </span>
                ) : (
                  <span class="text">{m.text}</span>
                )}
              </div>
              <span class="time mono">{m.side.toUpperCase()} {m.time}</span>
            </div>
            {"note" in m && (
              <span class="note mono">
                <i class="line" />
                <i class="sq" />
                {m.note}
              </span>
            )}
          </li>
        ))
      }
      <li class="exposed mono" data-reveal>
        <span class="bracket" aria-hidden="true"></span>
        <span><i class="sq"></i>One side exposed</span>
      </li>
    </ol>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }

  .lede {
    position: sticky;
    top: calc(var(--header-h) + 48px);
  }

  h2 {
    font-size: clamp(2.6rem, 5.4vw, 5rem);
  }

  .lede p {
    margin-top: 28px;
    max-width: 32ch;
    font-size: 1.2rem;
    line-height: 1.5;
    color: var(--text-2);
  }

  .thread {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 22px;
  }

  .msg {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 190px;
    align-items: center;
    gap: 24px;
  }

  .bubble-wrap {
    display: grid;
    gap: 8px;
    max-width: 420px;
  }

  .msg.b .bubble-wrap {
    justify-self: end;
  }

  .bubble {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 68px;
    padding: 0 20px;
    border: 1.5px solid var(--graphite);
    border-radius: 16px;
    background: color-mix(in srgb, var(--bone) 88%, white);
    font-family: var(--font-mono);
    font-size: 1rem;
  }

  .msg.b .bubble {
    flex-direction: row-reverse;
    justify-content: flex-end;
  }

  .who {
    display: grid;
    place-items: center;
    flex: none;
    width: 28px;
    height: 28px;
    border: 1.5px solid var(--graphite);
    border-radius: 50%;
    font-size: 0.7rem;
    font-weight: 600;
  }

  .time {
    padding-inline: 8px;
    font-size: 0.8rem;
    color: var(--text-2);
  }

  .msg.b .time {
    text-align: right;
  }

  .note {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .note .line {
    flex: 1 1 24px;
    height: 1px;
    background: var(--graphite);
    transform-origin: left;
  }

  .sq {
    flex: none;
    width: 9px;
    height: 9px;
    background: var(--vermilion);
  }

  .dots {
    display: inline-flex;
    gap: 6px;
  }

  .dots i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--graphite);
    animation: blink 1.4s infinite ease-in-out;
  }

  .dots i:nth-child(2) {
    animation-delay: 0.2s;
  }

  .dots i:nth-child(3) {
    animation-delay: 0.4s;
  }

  @keyframes blink {
    0%,
    80%,
    100% {
      opacity: 0.25;
    }
    40% {
      opacity: 1;
    }
  }

  .exposed {
    display: flex;
    align-items: center;
    gap: 14px;
    justify-content: flex-end;
    padding-right: 0;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .exposed .sq {
    display: inline-block;
    margin-right: 10px;
  }

  .bracket {
    flex: 1;
    height: 1.5px;
    background: var(--vermilion);
    max-width: 120px;
    transform-origin: right;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .lede {
      position: static;
    }

    .msg {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
    }

    .note .line {
      display: none;
    }

    .msg.b .note {
      justify-content: flex-end;
    }
  }
</style>
